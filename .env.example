# At least one API key is required.
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# Optional: force a provider ("gemini", "openai" or "vercel").
# Unset picks the first key present: gemini, then openai, then vercel.
IMAGE_PROVIDER=

# Optional model overrides.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
OPENAI_IMAGE_MODEL=gpt-image-2
VERCEL_IMAGE_MODEL=bfl/flux-3-image-klein

# Optional: where generated images are written. Defaults to <cwd>/out.
OUT_DIR=

# Optional transport settings (CLI flags take precedence).
MCP_TRANSPORT=stdio
MCP_PORT=8000
